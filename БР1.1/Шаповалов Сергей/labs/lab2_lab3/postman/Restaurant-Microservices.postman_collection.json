{
  "info": {
    "name": "Restaurant Microservices",
    "description": "Integration checks for auth, users, restaurants, reservations and reviews services",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth: Register user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Анна\",\n  \"last_name\": \"Смирнова\",\n  \"email\": \"anna@example.com\",\n  \"password\": \"secret123\"\n}"
        },
        "url": "http://localhost:3001/auth/register"
      }
    },
    {
      "name": "Auth: Login user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "http://localhost:3001/auth/login"
      }
    },
    {
      "name": "Auth: Verify token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{accessToken}}\"\n}"
        },
        "url": "http://localhost:3001/auth/verify"
      }
    },
    {
      "name": "Users: Get user by id",
      "request": {
        "method": "GET",
        "url": "http://localhost:3002/internal/users/1"
      }
    },
    {
      "name": "Restaurants: Get all",
      "request": {
        "method": "GET",
        "url": "http://localhost:3003/api/restaurants"
      }
    },
    {
      "name": "Restaurants: Get one",
      "request": {
        "method": "GET",
        "url": "http://localhost:3003/api/restaurants/1"
      }
    },
    {
      "name": "Reservations: Create reservation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurant\": 1,\n  \"start_time\": \"2026-10-01T19:00:00.000Z\",\n  \"guest_count\": 2\n}"
        },
        "url": "http://localhost:3004/api/reservations"
      }
    },
    {
      "name": "Reservations: My reservations",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "http://localhost:3004/api/reservations/my"
      }
    },
    {
      "name": "Reviews: Get all reviews",
      "request": {
        "method": "GET",
        "url": "http://localhost:3005/api/reviews"
      }
    },
    {
      "name": "Reviews: Add review",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurant\": 1,\n  \"rating\": 5,\n  \"comment\": \"Очень понравилось\"\n}"
        },
        "url": "http://localhost:3005/api/reviews"
      }
    }
  ],
  "variable": [
    { "key": "accessToken", "value": "" }
  ]
}
