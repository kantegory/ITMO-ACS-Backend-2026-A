    {
      "name": "7. Get properties",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Property list returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Property list contains items', function () {",
              "    pm.expect(body.items).to.be.an('array').that.is.not.empty;",
              "});",
              "const property = body.items.find(item => item.property_id === pm.collectionVariables.get('propertyId'));",
              "pm.test('Created property is in the list', function () {",
              "    pm.expect(property).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/properties",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "properties"
          ]
        }
      }
    },
    {
      "name": "8. Filter properties",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Filtered property list returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('All filtered items match the requested city and type', function () {",
              "    body.items.forEach(item => {",
              "        pm.expect(item.city).to.eql('Saint Petersburg');",
              "        pm.expect(item.property_type).to.eql('apartment');",
              "    });",
              "});",
              "pm.test('Created property matches the filter', function () {",
              "    pm.expect(body.items.some(item => item.property_id === pm.collectionVariables.get('propertyId'))).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/properties?city=Saint%20Petersburg&property_type=apartment&min_price=50000&max_price=80000&rooms_count=1",
