              "    pm.response.to.have.status(201);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Registered user has landlord role', function () {",
              "    pm.expect(body.role).to.eql('landlord');",
              "});",
              "pm.collectionVariables.set('landlordId', body.user_id);"
