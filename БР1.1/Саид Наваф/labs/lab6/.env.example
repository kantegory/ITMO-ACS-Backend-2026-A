# Скопируйте в .env и задайте свой пароль. Файл .env в git не попадает.
GRAFANA_ADMIN_PASSWORD=change-me
# Публичный адрес Grafana (через nginx, путь /grafana/)
GRAFANA_ROOT_URL=https://app-3658039a6377ba2f.up.railway.app/grafana/

# Почтовые алерты (SMTP2GO). Значения задаются только в .env на сервере, в git не попадают.
SMTP_HOST=mail.smtp2go.com:8025
SMTP_USER=
SMTP_PASSWORD=
# Адрес отправителя: должен быть подтверждён в SMTP2GO (Single sender email)
SMTP_FROM=
# Куда слать алерты
ALERT_EMAIL=
