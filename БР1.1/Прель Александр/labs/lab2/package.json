{
  "name": "restaurant-table-booking-api",
  "version": "1.0.0",
  "description": "Restaurant booking microservices - lab 2",
  "main": "dist/gateway/index.js",
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "setup:messaging": "node scripts/setup-messaging.cjs",
    "broker:start": "node scripts/broker.cjs start",
    "broker:stop": "node scripts/broker.cjs stop",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node scripts/start.cjs",
    "start:messaging": "node --env-file=.env.hw5 scripts/start.cjs",
    "stop:messaging": "node scripts/stop-messaging.cjs",
    "start:notifications": "node --env-file=.env.hw5 dist/notifications/index.js",
    "start:accounts": "node dist/accounts/index.js",
    "start:catalog": "node dist/catalog/index.js",
    "start:bookings": "node dist/bookings/index.js",
    "start:gateway": "node dist/gateway/index.js",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.cjs",
    "test:postman": "node scripts/postman.cjs",
    "test:postman:messaging": "node --env-file=.env.hw5 scripts/postman.cjs",
    "test:smoke:messaging": "node --env-file=.env.hw5 scripts/smoke-messaging.cjs",
    "test:messaging": "npm run build && node --test --test-concurrency=1 tests/messaging.integration.cjs"
  },
  "keywords": [
    "express",
    "typeorm",
    "restaurant",
    "booking"
  ],
  "author": "Alexander Prel",
  "license": "MIT",
  "dependencies": {
    "amqplib": "0.10.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.0",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^6.0.1",
    "typeorm": "^0.3.31"
  },
  "overrides": {
    "express": {
      "qs": "6.16.0"
    }
  },
  "devDependencies": {
    "@types/amqplib": "0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
