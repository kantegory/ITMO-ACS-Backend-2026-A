{
  "name": "restaurant-booking-lab3",
  "version": "1.0.0",
  "private": true,
  "description": "Local Docker Compose environment for lab 2 and HW5",
  "engines": { "node": ">=22" },
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "config:check": "node scripts/compose.cjs config --quiet",
    "build": "node scripts/compose.cjs build",
    "start": "node scripts/compose.cjs up --detach --wait --wait-timeout 120",
    "stop": "node scripts/compose.cjs stop",
    "down": "node scripts/compose.cjs down",
    "status": "node scripts/compose.cjs ps",
    "logs": "node scripts/compose.cjs logs --tail 80",
    "test": "node --test --test-concurrency=1 tests/compose.integration.cjs",
    "test:postman": "node scripts/postman.cjs",
    "test:smoke": "node scripts/smoke.cjs"
  }
}
