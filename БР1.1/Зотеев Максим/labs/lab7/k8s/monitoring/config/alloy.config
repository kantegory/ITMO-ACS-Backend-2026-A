discovery.kubernetes "pods" {
  role = "pod"
  namespaces { names = ["rental-lab7"] }
}
discovery.relabel "rental" {
  targets = discovery.kubernetes.pods.targets
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label = "app"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    regex = "api-gateway|identity-service|property-service|rental-service|messaging-service|rental-outbox|rabbit"
    action = "keep"
  }
}
loki.source.kubernetes "rental" {
  targets = discovery.relabel.rental.output
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}
