# {{ ansible_managed }}
# Отдельный compose-проект: remove_orphans при деплое приложения его не затрагивает.
# Лимиты памяти рассчитаны на 709 МиБ RAM и 1 ГиБ swap.
name: monitoring

services:
  grafana:
    # 13.x занимает 1.3 ГБ и не помещается на диск сервера, 10.4 — около 450 МБ.
    image: grafana/grafana-oss:10.4.19-security-01
    container_name: monitoring_grafana
    restart: unless-stopped
    mem_limit: 256m
    depends_on:
      - prometheus
      - loki
    # Опубликованные Docker порты обходят UFW, поэтому только 127.0.0.1:
    # Grafana открывается через SSH-туннель. Анонимный доступ — только на чтение.
    ports:
      - "127.0.0.1:{{ grafana_port }}:3000"
    environment:
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD}
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: Viewer
      # На 1 vCPU без WAL провижининг ловит "database is locked" при первом запуске.
      GF_DATABASE_WAL: "true"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH: /etc/grafana/dashboards/rental.json
      GF_SMTP_ENABLED: "true"
      GF_SMTP_HOST: ${SMTP_HOST}
      GF_SMTP_USER: ${SMTP_USER}
      GF_SMTP_PASSWORD: ${SMTP_PASSWORD}
      GF_SMTP_FROM_ADDRESS: ${SMTP_USER}
      GF_SMTP_FROM_NAME: Мониторинг rental
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/etc/grafana/dashboards:ro

  prometheus:
    image: prom/prometheus:v3.15.1
    container_name: monitoring_prometheus
    restart: unless-stopped
    mem_limit: 160m
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=2d
      - --storage.tsdb.retention.size=100MB
    volumes:
      - prometheus_data:/prometheus
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro

  loki:
    image: grafana/loki:3.7.9
    container_name: monitoring_loki
    restart: unless-stopped
    mem_limit: 200m
    command: -config.file=/etc/loki/loki.yml
    volumes:
      - loki_data:/loki
      - ./loki.yml:/etc/loki/loki.yml:ro

  promtail:
    image: grafana/promtail:3.6.11
    container_name: monitoring_promtail
    restart: unless-stopped
    mem_limit: 64m
    depends_on:
      - loki
    command: -config.file=/etc/promtail/promtail.yml
    volumes:
      - promtail_positions:/positions
      - ./promtail.yml:/etc/promtail/promtail.yml:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro

  # В сети хоста: иначе счётчики трафика были бы от контейнера, а не от ВМ.
  # Слушает только адрес шлюза сети мониторинга, поэтому снаружи недоступен.
  node-exporter:
    image: prom/node-exporter:v1.12.1
    container_name: monitoring_node_exporter
    restart: unless-stopped
    mem_limit: 32m
    network_mode: host
    pid: host
    depends_on:
      - prometheus
    command:
      - --path.rootfs=/host
      - --web.listen-address={{ monitoring_gateway }}:9100
    volumes:
      - /:/host:ro,rslave

  # Ходит в /health сервисов, поэтому подключён и к сети приложения.
  blackbox-exporter:
    image: prom/blackbox-exporter:v0.29.1
    container_name: monitoring_blackbox
    restart: unless-stopped
    mem_limit: 32m
    command: --config.file=/etc/blackbox/blackbox.yml
    networks:
      - default
      - rental
    volumes:
      - ./blackbox.yml:/etc/blackbox/blackbox.yml:ro

networks:
  default:
    ipam:
      config:
        - subnet: {{ monitoring_subnet }}
          gateway: {{ monitoring_gateway }}
  rental:
    external: true
    name: rental_default

volumes:
  grafana_data:
  prometheus_data:
  loki_data:
  promtail_positions:
