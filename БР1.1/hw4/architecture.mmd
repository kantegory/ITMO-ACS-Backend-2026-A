flowchart TB
    Client[Web or mobile client] -->|HTTPS REST| Gateway[API Gateway\npublic REST API]
    Gateway --> Routes[Public REST routing]

    subgraph Services[Domain services]
        direction LR
        Identity[Identity Service\nusers, roles, tokens]
        Property[Property Service\nproperties, favorites]
        Booking[Booking Service\nbookings, date rules]
        Contract[Contract and Billing\ncontracts, payments]
        Communication[Communication Service\nmessages, dialogs]
        Review[Review Service\nreviews]
    end

    Routes --> Identity
    Routes --> Property
    Routes --> Booking
    Routes --> Contract
    Routes --> Communication
    Routes --> Review

    Identity --> IdentityDB[(identity_db)]
    Property --> PropertyDB[(property_db)]
    Booking --> BookingDB[(booking_db)]
    Contract --> ContractDB[(contract_db)]
    Communication --> CommunicationDB[(communication_db)]
    Review --> ReviewDB[(review_db)]

    subgraph InternalCalls[Internal REST calls: caller -> callee]
        direction TB
        BookingCall[Booking Service] -->|GET property summary / ownership| PropertyCall[Property Service]
        BookingContractCall[Booking Service] -->|POST confirmed booking snapshot| ContractCall[Contract and Billing]
        CommunicationIdentityCall[Communication Service] -->|GET recipient status| IdentityCall[Identity Service]
        CommunicationPropertyCall[Communication Service] -->|GET property summary| PropertyValidationCall[Property Service]
        ReviewContractCall[Review Service] -->|GET review eligibility| ContractEligibilityCall[Contract and Billing]
    end

    classDef service fill:#eaf2f8,stroke:#245b7a,stroke-width:1px,color:#111;
    classDef db fill:#f7f3e8,stroke:#8a6d3b,stroke-width:1px,color:#111;
    classDef call fill:#eef7f0,stroke:#2f7d5a,stroke-width:1px,color:#111;
    class Identity,Property,Booking,Contract,Communication,Review,Gateway,Routes service;
    class IdentityDB,PropertyDB,BookingDB,ContractDB,CommunicationDB,ReviewDB db;
    class BookingCall,PropertyCall,BookingContractCall,ContractCall,CommunicationIdentityCall,IdentityCall,CommunicationPropertyCall,PropertyValidationCall,ReviewContractCall,ContractEligibilityCall call;
