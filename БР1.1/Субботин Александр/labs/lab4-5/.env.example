# Скопируйте в .env и заполните: cp .env.example .env
# .env в git не попадает (см. .gitignore).

# Какие compose-файлы поднимать по `docker compose up -d`:
#   на Linux-ВМ:          docker-compose.yaml:docker-compose.monitoring.yaml
#   на Docker Desktop:    добавьте :docker-compose.local.yaml
COMPOSE_FILE=docker-compose.yaml:docker-compose.monitoring.yaml
# mailpit — тестовый почтовый ящик для алертов; уберите, когда настроите реальный SMTP
COMPOSE_PROFILES=mailpit

# --- приложение (ЛР4) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
RABBITMQ_USER=rental
RABBITMQ_PASSWORD=change-me-rabbit
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
# api-gateway публикуется только на localhost, наружу — через nginx
GATEWAY_BIND=127.0.0.1:8080
# Postgres — только для администрирования через SSH-туннель
POSTGRES_BIND=127.0.0.1:5433

# --- образы (ДЗ6) ---
# build — собрать на сервере; pull — скачать готовые из реестра (CI);
# local — образы уже загружены (deploy/scripts/push-images.sh)
DEPLOY_MODE=build
IMAGE_PREFIX=rental
IMAGE_TAG=latest

# --- мониторинг (ЛР5) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_BIND=127.0.0.1:3000
# внешний адрес Grafana за nginx, например https://rental.example.com/grafana/ или http://203.0.113.10/grafana/
GRAFANA_ROOT_URL=http://localhost:3000/grafana/
PROMETHEUS_RETENTION=15d

# --- алерты на почту (доп. задание, 2 балла) ---
ALERT_EMAIL=you@example.com
# по умолчанию — mailpit (http://127.0.0.1:8025). Для реальной почты, например Яндекс:
#   SMTP_HOST=smtp.yandex.ru:465  SMTP_USER=login@yandex.ru  SMTP_PASSWORD=<пароль приложения>
#   SMTP_FROM=login@yandex.ru     SMTP_STARTTLS_POLICY=NoStartTLS
SMTP_HOST=mailpit:1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=grafana@rental.local
SMTP_STARTTLS_POLICY=OpportunisticStartTLS

# --- Sentry (доп. задание: self-hosted — 4 балла, облачный — 2 балла) ---
# пусто → SDK выключен. DSN берётся в Sentry: Project Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# true → GET /debug/sentry в каждом сервисе кидает тестовую панику
SENTRY_DEBUG_ROUTE=false
