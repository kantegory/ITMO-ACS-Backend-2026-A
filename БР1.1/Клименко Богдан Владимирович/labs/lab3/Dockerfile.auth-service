# ---------- Stage 1: build ----------
FROM node:20-slim AS builder

WORKDIR /app

# Зависимости для нативной сборки sharp / sqlite3
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src

RUN npm run build

# ---------- Stage 2: runtime ----------
FROM node:20-slim

WORKDIR /app

# Те же утилиты нужны для загрузки prebuilt-бинарей sharp/sqlite3
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

RUN mkdir -p temp-uploads

EXPOSE 3001
CMD ["node", "dist/index.js"]