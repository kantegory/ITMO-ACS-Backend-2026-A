# берем готовый linux образ с node.js
FROM node:20-slim
# устанавливаем рабочую директорию внутри контейнера
WORKDIR /app
# Копируем зависимости проекта в контейнер
COPY package*.json ./
#устанавливаем зависимости проекта
RUN npm install
# копируем все файлы проекта в контейнер
COPY . .
# приложение внутри контейнера работает на порту 8001
EXPOSE 8002
#Запускаем приложение внутри контейнера
CMD ["npm", "run", "dev"]