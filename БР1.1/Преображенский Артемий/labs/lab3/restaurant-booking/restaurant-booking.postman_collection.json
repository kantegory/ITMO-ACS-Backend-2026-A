        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"{{fullName}}\",\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/api/auth/register",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2);",
                  "pm.collectionVariables.set(\"email\", \"postman-\" + suffix + \"@example.org\");",
                  "for (const key of [\"token\", \"userId\", \"restaurantId\", \"tableId\", \"menuItemId\", \"reviewId\", \"bookingId\"]) pm.collectionVariables.set(key, \"\");",
                  "const start = new Date(); start.setUTCDate(start.getUTCDate() + 1); start.setUTCHours(18, 0, 0, 0);",
                  "pm.collectionVariables.set(\"startTime\", start.toISOString());",
                  "pm.collectionVariables.set(\"endTime\", new Date(start.getTime() + 3600000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Response fields\", function () {",
                  "  pm.expect(json.user).to.be.an(\"object\");",
                  "  pm.expect(json.user.id).to.match(/^[0-9a-f-]{36}$/i);",
                  "  pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"token\", json.token);",
                  "pm.collectionVariables.set(\"userId\", json.user.id);"
                ]
              }
            }
          ]
        },
