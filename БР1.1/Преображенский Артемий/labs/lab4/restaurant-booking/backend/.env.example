# Replace placeholder passwords with random hexadecimal strings.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_random_hex

POSTGRES_DB_AUTH=auth_db
POSTGRES_DB_CATALOG=catalog_db
POSTGRES_DB_BOOKING=booking_db

POSTGRES_PORT_AUTH=5433
POSTGRES_PORT_CATALOG=5434
POSTGRES_PORT_BOOKING=5435

JWT_SECRET=replace_with_random_hex_32_bytes
JWT_EXPIRES=24h

AUTH_DB_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@auth-db:5432/auth_db?sslmode=disable
CATALOG_DB_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@catalog-db:5432/catalog_db?sslmode=disable
BOOKING_DB_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@booking-db:5432/booking_db?sslmode=disable

AUTH_HTTP_ADDR=:8081
CATALOG_HTTP_ADDR=:8082
BOOKING_HTTP_ADDR=:8083

AUTH_SERVICE_PUBLISHED_PORT=8081
CATALOG_SERVICE_PUBLISHED_PORT=8082
BOOKING_SERVICE_PUBLISHED_PORT=8083

CATALOG_SERVICE_URL=http://catalog-service:8082

RABBITMQ_USERNAME=booking
RABBITMQ_PASSWORD=replace_with_another_random_hex
RABBITMQ_URL=amqp://${RABBITMQ_USERNAME}:${RABBITMQ_PASSWORD}@rabbitmq:5672/

RABBITMQ_PORT_AMQP=5672
RABBITMQ_PORT_MANAGEMENT=15672

COMPOSE_PROJECT_NAME=restaurant-booking
