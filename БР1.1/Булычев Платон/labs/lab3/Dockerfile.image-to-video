FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./

COPY packages ./packages
COPY apps/image-to-video ./apps/image-to-video

RUN pnpm install --frozen-lockfile
RUN pnpm packages -r build

WORKDIR /app/apps/image-to-video

EXPOSE 3002

CMD ["pnpm", "serverless", "offline", "--host", "0.0.0.0", "--httpPort", "3002"]
