# Общие секреты для учебного окружения. В реальном проекте секреты должны быть разными и храниться безопасно.
SERVICE_TOKEN=fitness-service-token
GATEWAY_TOKEN=fitness-gateway-token
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900
JWT_REFRESH_TOKEN_LIFETIME_SECONDS=604800

# API Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
IDENTITY_SERVICE_URL=http://localhost:3001
CATALOG_SERVICE_URL=http://localhost:3002
PLANS_SERVICE_URL=http://localhost:3003
PROGRESS_SERVICE_URL=http://localhost:3004
CONTENT_SERVICE_URL=http://localhost:3005
MEDIA_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007

# Один PostgreSQL-сервер используется только для удобства локального запуска,
# но каждый сервис подключается к отдельной базе и отдельным пользователем.
DB_HOST=localhost
DB_PORT=15432

IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=identity_password

CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_password

PLANS_DB_NAME=plans_db
PLANS_DB_USER=plans_user
PLANS_DB_PASSWORD=plans_password

PROGRESS_DB_NAME=progress_db
PROGRESS_DB_USER=progress_user
PROGRESS_DB_PASSWORD=progress_password

CONTENT_DB_NAME=content_db
CONTENT_DB_USER=content_user
CONTENT_DB_PASSWORD=content_password

MEDIA_DB_NAME=media_db
MEDIA_DB_USER=media_user
MEDIA_DB_PASSWORD=media_password

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=notification_password

IDENTITY_PORT=3001
CATALOG_PORT=3002
PLANS_PORT=3003
PROGRESS_PORT=3004
CONTENT_PORT=3005
MEDIA_PORT=3006
NOTIFICATION_PORT=3007

# RabbitMQ: локально сервисы подключаются к published port 5672.
RABBITMQ_URL=amqp://fitness:fitness@localhost:5672
RABBITMQ_EXCHANGE=fitness.events
RABBITMQ_DEAD_LETTER_EXCHANGE=fitness.events.dlx
RABBITMQ_RETRY_DELAY_MS=3000
