{
  "info": {
    "name": "Fitness Microservices Lab2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "trainerToken",
      "value": ""
    },
    {
      "key": "userTrainingPlanId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health/services",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health",
            "services"
          ]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('userToken', data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"user@example.com\", \"password\": \"User12345!\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login trainer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('trainerToken', data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"trainer@example.com\", \"password\": \"Trainer123!\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "List workouts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/workouts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "workouts"
              ]
            }
          }
        },
        {
          "name": "List metadata",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/metadata/difficulty-levels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "metadata",
                "difficulty-levels"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Training plans",
      "item": [
        {
          "name": "List plans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/training-plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "training-plans"
              ]
            }
          }
        },
        {
          "name": "Enroll user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.userTrainingPlan) pm.collectionVariables.set('userTrainingPlanId', data.userTrainingPlan.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"startDate\": \"2026-06-29\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/training-plans/1/enroll",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "training-plans",
                "1",
                "enroll"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Progress",
      "item": [
        {
          "name": "Create body metric",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"measuredAt\": \"2026-06-29\", \"weightKg\": 60.5, \"waistCm\": 70}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me/body-metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me",
                "body-metrics"
              ]
            }
          }
        },
        {
          "name": "Complete workout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"workoutId\": 1, \"userTrainingPlanId\": \"{{userTrainingPlanId}}\", \"startedAt\": \"2026-06-29T10:00:00.000Z\", \"completedAt\": \"2026-06-29T10:30:00.000Z\", \"durationFactMin\": 30, \"rating\": 5}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me/workout-sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me",
                "workout-sessions"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/me/notifications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "me",
            "notifications"
          ]
        }
      }
    }
  ]
}
