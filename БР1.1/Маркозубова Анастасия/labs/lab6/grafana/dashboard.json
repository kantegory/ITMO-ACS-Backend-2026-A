{
  "uid": "lab6-backend",
  "title": "ЛР6 · Мониторинг бэкенда",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Контейнер",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "lab6-loki"
        },
        "query": "label_values({job=\"docker\"}, container)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU ВМ, %",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab6-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lab6-prom"
          },
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"vm\",mode=\"idle\"}[2m])))",
          "legendFormat": "Использовано"
        }
      ]
    },
    {
      "id": 2,
      "title": "RAM ВМ, %",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab6-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lab6-prom"
          },
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"vm\"} / node_memory_MemTotal_bytes{job=\"vm\"})",
          "legendFormat": "Использовано"
        }
      ]
    },
    {
      "id": 3,
      "title": "Диск /, %",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab6-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lab6-prom"
          },
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"vm\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"vm\",mountpoint=\"/\"})",
          "legendFormat": "Использовано"
        }
      ]
    },
    {
      "id": 4,
      "title": "Сеть ВМ, байт/с",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab6-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lab6-prom"
          },
          "refId": "A",
          "expr": "sum(rate(node_network_receive_bytes_total{job=\"vm\",device!~\"lo|docker.*|veth.*|br-.*\"}[2m]))",
          "legendFormat": "Входящий"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lab6-prom"
          },
          "refId": "B",
          "expr": "sum(rate(node_network_transmit_bytes_total{job=\"vm\",device!~\"lo|docker.*|veth.*|br-.*\"}[2m]))",
          "legendFormat": "Исходящий"
        }
      ]
    },
    {
      "id": 10,
      "title": "auth",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab6-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lab6-prom"
          },
          "refId": "A",
          "expr": "min(probe_success{job=\"microservices\",service=\"auth\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
