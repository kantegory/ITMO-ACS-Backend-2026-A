        "y": 18,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "loki",
        "uid": "lab6-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "lab6-loki"
          },
          "refId": "A",
          "expr": "{job=\"docker\",container=~\"${container:regex}\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
