          "uid": "lab6-health-auth",
          "title": "API недоступен: auth",
          "condition": "B",
          "for": "1m",
          "noDataState": "Alerting",
          "execErrState": "Error",
          "annotations": {
            "summary": "Сервис auth не отвечает HTTP 200 на /docs/.",
            "__dashboardUid__": "lab6-backend",
            "__panelId__": "10"
          },
          "labels": {
            "service": "auth",
            "project": "backend-lab6"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "lab6-prom",
              "relativeTimeRange": {
                "from": 120,
                "to": 0
              },
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "prometheus",
                  "uid": "lab6-prom"
                },
                "expr": "min(probe_success{job=\"microservices\",service=\"auth\"}) or vector(0)",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 1000
              }
            },
            {
              "refId": "B",
