{
  "uid": "app-kubernetes",
  "title": "Рабочий проект · Kubernetes и нагрузка",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "tags": [
    "app",
    "kubernetes"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "namespace",
        "type": "constant",
        "query": "app-semester",
        "hide": 2,
        "current": {
          "text": "app-semester",
          "value": "app-semester"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU gateway по pod, ядер",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container=\"gateway\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} usage",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (kube_pod_container_resource_requests{namespace=\"$namespace\",container=\"gateway\",resource=\"cpu\"})",
          "legendFormat": "{{pod}} requests",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Память gateway и ml-service",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod,container) (container_memory_working_set_bytes{namespace=\"$namespace\",container=~\"gateway|ml-service\"})",
          "legendFormat": "{{pod}} working set",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (pod,container) (kube_pod_container_resource_limits{namespace=\"$namespace\",container=~\"gateway|ml-service\",resource=\"memory\"})",
          "legendFormat": "{{pod}} limit",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HPA gateway, реплики",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\",horizontalpodautoscaler=\"app-gateway\"}",
          "legendFormat": "Текущее",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"$namespace\",horizontalpodautoscaler=\"app-gateway\"}",
          "legendFormat": "Целевое",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU throttling gateway, %",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"$namespace\",container=\"gateway\"}[$__rate_interval])) / clamp_min(sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=\"$namespace\",container=\"gateway\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{pod}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Задержка на Traefik, секунды",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"$namespace-gateway-.*\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"$namespace-gateway-.*\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "ml-service: реплики и рестарты",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\",deployment=\"app-ml-service\"}",
          "legendFormat": "доступно реплик",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\",container=~\"ml-service|gateway|classification-worker|file-worker|scheduler\"}[$__rate_interval]))",
          "legendFormat": "рестарты за интервал",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
