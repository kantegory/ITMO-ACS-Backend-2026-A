APP_PORT=3002

# своя база сервиса
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recipe_db
DB_USER=postgres
DB_PASSWORD=ВПИШИ_СВОЙ_ПАРОЛЬ
DB_ENTITIES=src/models/*.entity.ts
DB_SUBSCRIBERS=src/models/*.subscriber.ts

JWT_SECRET_KEY=change-me

# адреса соседних сервисов
USER_SERVICE_URL=http://localhost:3001/api
RECIPE_SERVICE_URL=http://localhost:3002/api
SOCIAL_SERVICE_URL=http://localhost:3003/api

# общий ключ для запросов между BFF и сервисами: без него сервис отвечает 403
INTERNAL_API_KEY=change-me

# RabbitMQ: recipe-service отправляет событие «рецепт удалён», social-service его обрабатывает
RABBITMQ_URL=amqp://guest:guest@localhost:5672
