APP_PORT=3004

# адреса сервисов, в которые BFF пересылает запросы
USER_SERVICE_URL=http://localhost:3001/api
RECIPE_SERVICE_URL=http://localhost:3002/api
SOCIAL_SERVICE_URL=http://localhost:3003/api

# общий ключ для запросов между BFF и сервисами: без него сервис отвечает 403
INTERNAL_API_KEY=change-me
