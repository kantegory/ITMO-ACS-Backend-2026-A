APP_PORT=3001

# своя база сервиса
DB_HOST=localhost
DB_PORT=5432
DB_NAME=user_db
DB_USER=postgres
DB_PASSWORD=ВПИШИ_СВОЙ_ПАРОЛЬ
DB_ENTITIES=src/models/*.entity.ts
DB_SUBSCRIBERS=src/models/*.subscriber.ts

# общий для всех сервисов ключ: user-service подписывает токены, остальные проверяют
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_LIFETIME=3600

# общий ключ для запросов между BFF и сервисами: без него сервис отвечает 403
INTERNAL_API_KEY=change-me
