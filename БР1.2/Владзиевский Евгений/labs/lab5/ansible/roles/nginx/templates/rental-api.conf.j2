# {{ ansible_managed }}
# Обратный прокси для rental-приложения (ЛР4), шаблон Ansible (ЛР5)

{% if grafana_enabled | default(false) %}
# Для websocket-соединений Grafana (директива map допустима в контексте http,
# куда и подключается этот файл через include sites-enabled/*)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

{% endif %}
upstream {{ nginx_site_name | replace('-', '_') }}_upstream {
    server {{ nginx_upstream_host }}:{{ nginx_upstream_port }};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_server_name }};

    client_max_body_size {{ nginx_client_max_body_size }};
    server_tokens off;

    gzip on;
    gzip_proxied any;
    gzip_min_length 256;
    gzip_types application/json text/plain;

    access_log /var/log/nginx/{{ nginx_site_name }}.access.log;
    error_log  /var/log/nginx/{{ nginx_site_name }}.error.log warn;

    location / {
        proxy_pass http://{{ nginx_site_name | replace('-', '_') }}_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }

{% if grafana_enabled | default(false) %}
    # Grafana (ЛР6) отдаётся на подпути /grafana/
    location /grafana/ {
        proxy_pass http://{{ grafana_host | default('127.0.0.1') }}:{{ grafana_port | default(3000) }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Live-канал Grafana работает по websocket
    location /grafana/api/live/ {
        proxy_pass http://{{ grafana_host | default('127.0.0.1') }}:{{ grafana_port | default(3000) }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $host;
    }
{% endif %}

    location = /health {
        proxy_pass http://{{ nginx_site_name | replace('-', '_') }}_upstream/health;
        proxy_set_header Host $host;
        access_log off;
    }
}
