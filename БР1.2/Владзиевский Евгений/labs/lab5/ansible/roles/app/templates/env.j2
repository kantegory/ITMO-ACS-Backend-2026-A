# {{ ansible_managed }}
# Файл создаётся Ansible один раз: при повторных запусках не перезаписывается
# (template force: false), иначе менялись бы пароли БД и инвалидировались JWT.

JWT_SECRET={{ lookup('ansible.builtin.password', '/dev/null', length=64, chars=['hexdigits']) | lower }}
SERVICE_TOKEN={{ lookup('ansible.builtin.password', '/dev/null', length=64, chars=['hexdigits']) | lower }}
{% for db in app_databases %}

{{ db.prefix }}_DB_USER={{ db.user }}
{{ db.prefix }}_DB_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=32, chars=['hexdigits']) | lower }}
{{ db.prefix }}_DB_NAME={{ db.name }}
{% endfor %}
