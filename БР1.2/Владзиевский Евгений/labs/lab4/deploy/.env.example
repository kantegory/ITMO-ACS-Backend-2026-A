# Пример файла окружения для production-развёртывания (ЛР4).
# На сервере хранится как /opt/rental-app/.env и НЕ коммитится в репозиторий.
# Реальные значения JWT_SECRET и SERVICE_TOKEN генерируются скриптом deploy.sh
# командой `openssl rand -hex 32`.

# Общие секреты
JWT_SECRET=change-me-to-random-64-hex
SERVICE_TOKEN=change-me-to-random-64-hex

# auth-service
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=change-me
AUTH_DB_NAME=auth_db

# property-service
PROPERTY_DB_USER=property
PROPERTY_DB_PASSWORD=change-me
PROPERTY_DB_NAME=property_catalog_db

# booking-service
BOOKING_DB_USER=booking
BOOKING_DB_PASSWORD=change-me
BOOKING_DB_NAME=booking_db

# payment-service
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=change-me
PAYMENT_DB_NAME=payment_db

# messaging-service
MESSAGING_DB_USER=messaging
MESSAGING_DB_PASSWORD=change-me
MESSAGING_DB_NAME=messaging_db
