{
  "name": "restaurant-booking-microservices",
  "version": "1.0.0",
  "description": "Restaurant booking backend split into microservices with database-per-service",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -n gateway,auth,catalog,menu,media,booking,review -c auto \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:catalog\" \"npm run dev:menu\" \"npm run dev:media\" \"npm run dev:booking\" \"npm run dev:review\"",
    "start": "concurrently -n gateway,auth,catalog,menu,media,booking,review -c auto \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:catalog\" \"npm run start:menu\" \"npm run start:media\" \"npm run start:booking\" \"npm run start:review\"",
    "dev:gateway": "nodemon services/api-gateway/src/server.js",
    "dev:auth": "nodemon services/auth-user-service/src/server.js",
    "dev:catalog": "nodemon services/catalog-service/src/server.js",
    "dev:menu": "nodemon services/menu-service/src/server.js",
    "dev:media": "nodemon services/media-service/src/server.js",
    "dev:booking": "nodemon services/booking-service/src/server.js",
    "dev:review": "nodemon services/review-service/src/server.js",
    "start:gateway": "node services/api-gateway/src/server.js",
    "start:auth": "node services/auth-user-service/src/server.js",
    "start:catalog": "node services/catalog-service/src/server.js",
    "start:menu": "node services/menu-service/src/server.js",
    "start:media": "node services/media-service/src/server.js",
    "start:booking": "node services/booking-service/src/server.js",
    "start:review": "node services/review-service/src/server.js",
    "seed": "npm run seed:auth && npm run seed:catalog && npm run seed:menu && npm run seed:media && npm run seed:booking && npm run seed:review",
    "seed:auth": "node services/auth-user-service/src/seed.js",
    "seed:catalog": "node services/catalog-service/src/seed.js",
    "seed:menu": "node services/menu-service/src/seed.js",
    "seed:media": "node services/media-service/src/seed.js",
    "seed:booking": "node services/booking-service/src/seed.js",
    "seed:review": "node services/review-service/src/seed.js",
    "reset:db": "node scripts/reset-databases.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}