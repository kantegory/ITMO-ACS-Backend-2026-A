@baseUrl = http://localhost:3000/api
@token = вставь_сюда_JWT_после_login
@adminToken = вставь_сюда_JWT_админа_после_login

### Health Gateway
GET http://localhost:3000/health

### Login user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "User12345"
}

### Restaurants
GET {{baseUrl}}/restaurants

### Filter restaurants
GET {{baseUrl}}/restaurants?city=Москва&price_category=medium

### Restaurant details before review events
GET {{baseUrl}}/restaurants/1

### Menu
GET {{baseUrl}}/restaurants/1/menu

### Photos
GET {{baseUrl}}/restaurants/1/photos

### Tables
GET {{baseUrl}}/restaurants/1/tables

### Create booking -> publishes booking.created
POST {{baseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "restaurant_id": 1,
  "table_id": 2,
  "guests_count": 4,
  "booking_start": "2026-06-25T18:00:00.000Z",
  "booking_end": "2026-06-25T20:00:00.000Z"
}

### My bookings
GET {{baseUrl}}/bookings/my
Authorization: Bearer {{token}}

### Cancel booking -> publishes booking.cancelled
PATCH {{baseUrl}}/bookings/2/cancel
Authorization: Bearer {{token}}

### My notifications -> consumed from RabbitMQ by Notification Service
GET {{baseUrl}}/notifications/my
Authorization: Bearer {{token}}

### Create review for cancelled booking -> publishes review.created, Catalog Service updates rating
POST {{baseUrl}}/restaurants/1/reviews
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "booking_id": 2,
  "rating": 4,
  "comment": "Хорошее место, удобное бронирование"
}

### Restaurant details after review event
GET {{baseUrl}}/restaurants/1

### Login admin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Admin12345"
}

### All notifications, admin only
GET {{baseUrl}}/notifications
Authorization: Bearer {{adminToken}}
