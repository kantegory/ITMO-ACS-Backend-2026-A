        {
          "name": "10 Просмотр столиков ресторана",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/restaurants/{{restaurantId}}/tables",
            "description": "Находит активный столик с достаточным количеством мест."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Столики ресторана возвращают 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Есть доступные столики\", function () {",
                  "    pm.expect(json.data).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "const guestsCount = Number(pm.environment.get(\"guestsCount\") || 2);",
                  "const availableTable = json.data.find((table) => table.is_active && table.seats_count >= guestsCount);",
                  "",
                  "pm.test(\"Найден активный столик с нужным количеством мест\", function () {",
                  "    pm.expect(availableTable, \"availableTable\").to.not.be.undefined;",
                  "});",
                  "",
                  "pm.environment.set(\"tableId\", availableTable.id);",
                  "pm.environment.set(\"tableSeatsCount\", availableTable.seats_count);"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Создание бронирования",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "description": "Создаёт бронирование для выбранного ресторана и столика.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurant_id\": \"{{restaurantId}}\",\n  \"table_id\": \"{{tableId}}\",\n  \"guests_count\": \"{{guestsCount}}\",\n  \"booking_start\": \"{{bookingStart}}\",\n  \"booking_end\": \"{{bookingEnd}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = new Date();",
                  "const daysOffset = 14 + Math.floor(Math.random() * 120);",
                  "const hoursOffset = Math.floor(Math.random() * 8);",
                  "const start = new Date(now.getTime() + daysOffset * 24 * 60 * 60 * 1000);",
                  "start.setUTCHours(12 + hoursOffset, 0, 0, 0);",
                  "const end = new Date(start.getTime() + 2 * 60 * 60 * 1000);",
                  "pm.environment.set(\"bookingStart\", start.toISOString());",
                  "pm.environment.set(\"bookingEnd\", end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Создание бронирования возвращает 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Бронирование создано для выбранного ресторана и столика\", function () {",
                  "    pm.expect(json.booking.restaurant_id).to.eql(Number(pm.environment.get(\"restaurantId\")));",
                  "    pm.expect(json.booking.table_id).to.eql(Number(pm.environment.get(\"tableId\")));",
                  "    pm.expect(json.booking.guests_count).to.eql(Number(pm.environment.get(\"guestsCount\")));",
                  "});",
                  "",
                  "pm.test(\"Новое бронирование имеет статус pending\", function () {",
                  "    pm.expect(json.booking.status).to.eql(\"pending\");",
                  "});",
                  "",
                  "pm.environment.set(\"bookingId\", json.booking.id);"
                ]
              }
            }
          ]
        },
