            "url": "{{baseUrl}}/api/bookings/my",
            "description": "Проверяет, что созданное бронирование появилось в истории пользователя."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"История бронирований возвращает 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"История бронирований возвращается массивом\", function () {",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Созданное бронирование есть в истории пользователя\", function () {",
                  "    const bookingId = Number(pm.environment.get(\"bookingId\"));",
                  "    const found = json.data.some((booking) => booking.id === bookingId);",
                  "    pm.expect(found).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "14 Просмотр созданного бронирования",
          "request": {
            "method": "GET",
            "header": [
