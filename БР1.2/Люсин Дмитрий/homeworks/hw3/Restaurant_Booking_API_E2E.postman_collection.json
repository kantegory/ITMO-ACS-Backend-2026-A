                  "});",
                  "",
                  "pm.test(\"Если категории есть, у них есть название и список блюд\", function () {",
                  "    if (json.data.length > 0) {",
                  "        pm.expect(json.data[0]).to.have.property(\"name\");",
                  "        pm.expect(json.data[0]).to.have.property(\"items\");",
                  "    }",
                  "});"
                ]
              }
