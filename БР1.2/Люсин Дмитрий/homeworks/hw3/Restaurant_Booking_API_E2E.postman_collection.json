    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Ответ получен быстрее 2000 мс\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Основной пользовательский сценарий",
      "description": "E2E-сценарий основного процесса приложения.",
      "item": [
        {
          "name": "01 Регистрация нового пользователя",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Создаёт нового пользователя с уникальным email для каждого запуска коллекции.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testUserName}}\",\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\",\n  \"phone\": \"{{testUserPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now();",
                  "pm.environment.set(\"runId\", String(runId));",
                  "pm.environment.set(\"testUserName\", `Postman User ${runId}`);",
                  "pm.environment.set(\"testUserEmail\", `postman_user_${runId}@example.com`);",
                  "pm.environment.set(\"testUserPassword\", \"User12345\");",
                  "pm.environment.set(\"testUserPhone\", `+7999${String(runId).slice(-7)}`);",
                  "pm.environment.set(\"guestsCount\", \"2\");",
                  "pm.environment.unset(\"authToken\");",
                  "pm.environment.unset(\"restaurantId\");",
                  "pm.environment.unset(\"tableId\");",
                  "pm.environment.unset(\"bookingId\");",
                  "pm.environment.unset(\"reviewId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Регистрация возвращает 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"В ответе есть JWT token\", function () {",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Email созданного пользователя совпадает с тестовым\", function () {",
                  "    pm.expect(json.user.email).to.eql(pm.environment.get(\"testUserEmail\"));",
                  "});",
                  "",
                  "pm.test(\"Пароль не возвращается в ответе\", function () {",
                  "    pm.expect(json.user).to.not.have.property(\"password_hash\");",
                  "    pm.expect(json.user).to.not.have.property(\"password\");",
                  "});",
                  "",
                  "pm.environment.set(\"registeredUserId\", json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Вход пользователя",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Проверяет вход и сохраняет JWT-токен в переменную authToken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Вход возвращает 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"В ответе есть JWT token\", function () {",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Пользователь вошёл под тем же email\", function () {",
                  "    pm.expect(json.user.email).to.eql(pm.environment.get(\"testUserEmail\"));",
                  "});",
                  "",
                  "pm.environment.set(\"authToken\", json.token);",
                  "pm.environment.set(\"userId\", json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Получение текущего пользователя",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Проверяет, что JWT-токен работает и сервер возвращает текущего пользователя."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Получение текущего пользователя возвращает 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Текущий пользователь совпадает с авторизованным\", function () {",
                  "    pm.expect(json.user.id).to.eql(Number(pm.environment.get(\"userId\")));",
                  "    pm.expect(json.user.email).to.eql(pm.environment.get(\"testUserEmail\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Получение списка кухонь",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/cuisines",
            "description": "Берёт id кухни для дальнейшей фильтрации ресторанов."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Список кухонь возвращает 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"В ответе есть массив кухонь\", function () {",
                  "    pm.expect(json.data).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "const italian = json.data.find((item) => item.name === \"Итальянская\") || json.data[0];",
                  "pm.environment.set(\"cuisineId\", italian.id);",
                  "pm.environment.set(\"cuisineName\", italian.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Получение списка ресторанов",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/restaurants?page=1&limit=10",
            "description": "Проверяет публичный список ресторанов и пагинацию."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Список ресторанов возвращает 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"В ответе есть массив ресторанов\", function () {",
                  "    pm.expect(json.data).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "pm.test(\"В ответе есть meta для пагинации\", function () {",
                  "    pm.expect(json.meta).to.be.an(\"object\");",
                  "    pm.expect(json.meta).to.have.property(\"total\");",
                  "    pm.expect(json.meta).to.have.property(\"page\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Фильтрация ресторанов",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/restaurants?cuisine_id={{cuisineId}}&city=Москва&price_category=medium&min_average_check=1000&max_average_check=3000&page=1&limit=10",
            "description": "Фильтрует рестораны и случайно выбирает один ресторан из результата."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Фильтрация ресторанов возвращает 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"После фильтрации найден хотя бы один ресторан\", function () {",
                  "    pm.expect(json.data).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Найденные рестораны соответствуют фильтрам\", function () {",
                  "    json.data.forEach((restaurant) => {",
                  "        pm.expect(restaurant.city).to.include(\"Москва\");",
                  "        pm.expect(restaurant.price_category).to.eql(\"medium\");",
                  "        pm.expect(restaurant.average_check).to.be.within(1000, 3000);",
                  "    });",
                  "});",
                  "",
                  "const randomIndex = Math.floor(Math.random() * json.data.length);",
                  "const selectedRestaurant = json.data[randomIndex];",
                  "pm.environment.set(\"restaurantId\", selectedRestaurant.id);",
                  "pm.environment.set(\"restaurantName\", selectedRestaurant.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Просмотр страницы ресторана",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/restaurants/{{restaurantId}}",
            "description": "Проверяет страницу выбранного ресторана."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Детальная страница ресторана возвращает 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"ID ресторана совпадает с выбранным\", function () {",
                  "    pm.expect(json.restaurant.id).to.eql(Number(pm.environment.get(\"restaurantId\")));",
                  "});",
                  "",
                  "pm.test(\"У ресторана есть базовые поля\", function () {",
                  "    pm.expect(json.restaurant).to.have.property(\"name\");",
                  "    pm.expect(json.restaurant).to.have.property(\"address\");",
                  "    pm.expect(json.restaurant).to.have.property(\"average_check\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Просмотр меню ресторана",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/restaurants/{{restaurantId}}/menu",
            "description": "Проверяет меню выбранного ресторана."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
