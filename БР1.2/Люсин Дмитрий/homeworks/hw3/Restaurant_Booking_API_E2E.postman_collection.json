          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Фотографии ресторана возвращают 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Фотографии возвращаются массивом\", function () {",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "});"
