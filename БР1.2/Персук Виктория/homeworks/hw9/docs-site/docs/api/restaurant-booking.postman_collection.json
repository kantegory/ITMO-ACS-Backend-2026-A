            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/users/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+79999999999\"\n}"
            },
            "description": "Обновить профиль текущего пользователя.\n\n`PATCH /users/me`\n\nПроверки: Status 200; Phone updated."
          }
        },
        {
          "name": "Login wrong password (expect error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns error message', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('message');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "description": "Вход в систему.\n\n`POST /auth/login`\n\nПроверки: Returns error message."
          }
        }
