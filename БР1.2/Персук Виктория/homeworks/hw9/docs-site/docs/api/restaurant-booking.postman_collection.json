              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Phone updated', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.phone).to.eql('+79999999999');",
                  "});"
                ]
