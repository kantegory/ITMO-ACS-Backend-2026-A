{
  "info": {
    "name": "Restaurant Booking — микросервисы (ЛР2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Коллекция запросов к API платформы бронирования ресторанов.\n\nВсе запросы идут через **api-gateway**. Адрес задаётся переменной окружения `base_url`:\n\n* окружение **Local** — `http://localhost:3000/api/v1` (Docker Compose);\n* окружение **EKS** — адрес балансировщика ALB в AWS.\n\nПапки выполняются по порядку и образуют сквозной сценарий. Скрипты тестов сохраняют токены и идентификаторы созданных объектов в переменные коллекции, поэтому коллекцию можно запустить целиком через Collection Runner или Newman.\n\nДля запроса верификации ресторана нужен администратор, созданный в базе заранее (см. раздел «Сценарии работы» документации)."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "restaurant_id",
      "value": ""
    },
    {
      "key": "table_id",
      "value": ""
    },
    {
      "key": "reservation_id",
      "value": ""
    },
    {
      "key": "menu_id",
      "value": ""
    },
    {
      "key": "menu_item_id",
      "value": ""
    },
    {
      "key": "review_id",
      "value": ""
    },
    {
      "key": "cuisine_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('test_email', 'testuser_' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has accessToken', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('accessToken');",
                  "  pm.collectionVariables.set('token', json.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"password123\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"phone\": \"+79001234567\"\n}"
            },
            "description": "Регистрация нового пользователя.\n\n`POST /auth/register`\n\nПроверки: Status 201; Has accessToken."
          }
        },
        {
          "name": "Register admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 or 400 (already exists)', () => {",
                  "  pm.expect([201, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\",\n  \"first_name\": \"Admin\",\n  \"last_name\": \"Root\"\n}"
            },
            "description": "Регистрация нового пользователя.\n\n`POST /auth/register`\n\nПроверки: Status 201 or 400 (already exists)."
          }
        },
        {
          "name": "Login user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has accessToken', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('accessToken');",
