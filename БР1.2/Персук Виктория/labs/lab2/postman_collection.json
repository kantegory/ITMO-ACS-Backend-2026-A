            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Restaurant\",\n  \"description\": \"A great place\",\n  \"address\": \"123 Main St\",\n  \"city\": \"Moscow\",\n  \"price\": \"$$\"\n}"
            }
