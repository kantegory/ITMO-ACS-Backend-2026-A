          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/restaurants/{{restaurant_id}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Saint Petersburg\"\n}"
            }
          }
        },
        {
          "name": "Verify restaurant (admin token — requires DB-seeded admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has status field or forbidden message', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.satisfy(r => r.status === 'Verified' || typeof r.message === 'string');",
                  "  if (json.status === 'Verified') pm.collectionVariables.set('restaurant_verified', 'true');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/restaurants/{{restaurant_id}}/verify",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
