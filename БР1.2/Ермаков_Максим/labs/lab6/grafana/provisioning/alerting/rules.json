{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "Проверка микросервисов",
      "folder": "ЛР6",
      "interval": "20s",
      "rules": [
        {
          "uid": "lab6-service-unavailable",
          "title": "Микросервис недоступен",
          "condition": "C",
          "for": "60s",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "isPaused": false,
          "annotations": {
            "summary": "Сервис {{ $labels.service }} недоступен на it-garage",
            "description": "HTTP /health не проходит проверку более минуты. После восстановления отправляется уведомление о восстановлении.",
            "__dashboardUid__": "lab6-it-garage",
            "__panelId__": "17"
          },
          "labels": {
            "severity": "critical",
            "server": "it-garage",
            "lab": "lab6"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "datasourceUid": "lab6-prometheus",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "prometheus",
                  "uid": "lab6-prometheus"
                },
                "expr": "probe_success{job=\"microservices_health\"}",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "threshold",
                "expression": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        1
                      ],
                      "type": "lt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
