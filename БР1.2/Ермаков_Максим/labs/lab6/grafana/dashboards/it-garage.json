{
  "id": null,
  "uid": "lab6-it-garage",
  "title": "it-garage — мониторинг микросервисов",
  "description": "ЛР6: ресурсы Ubuntu ВМ, HTTP healthcheck каждого микросервиса и логи всех Docker-контейнеров.",
  "tags": [
    "ЛР6",
    "it-garage"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "CPU ВМ",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lab6-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"vm\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "lab6-prometheus"
          },
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
