[
  {
    "title": "VM CPU %",
    "expression": "100 * (1 - avg(sum by(cpu) (rate(node_cpu_seconds_total{mode=~\"idle|iowait\"}[2m]))))",
    "status": "success",
    "series_count": 1
  },
  {
    "title": "VM RAM used",
    "expression": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
    "status": "success",
    "series_count": 1
  },
  {
    "title": "Node root filesystem used %",
    "expression": "100 * (1-node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs\"}/node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs\"})",
    "status": "success",
    "series_count": 1
  },
  {
    "title": "VM network RX bytes/s",
    "expression": "sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*|cni.*|flannel.*\"}[2m]))",
    "status": "success",
    "series_count": 1
  },
  {
    "title": "Backend CPU cores",
    "expression": "sum by(pod) (rate(container_cpu_usage_seconds_total{namespace=\"job-platform\",container=\"app\"}[2m]))",
    "status": "success",
    "series_count": 9
  },
  {
    "title": "Backend working set",
    "expression": "container_memory_working_set_bytes{namespace=\"job-platform\",container=\"app\"}",
    "status": "success",
    "series_count": 12
  },
  {
    "title": "All microservices reachable",
    "expression": "probe_success{job=\"microservices\"}",
    "status": "success",
    "series_count": 7
  },
  {
    "title": "k6 request rate",
    "expression": "sum by(run) (rate(k6_http_reqs_total{phase=\"load\"}[1m]))",
    "status": "success",
    "series_count": 6
  },
  {
    "title": "k6 latency p95",
    "expression": "1000 * k6_http_req_duration_p95{phase=\"load\"}",
    "status": "success",
    "series_count": 19
  },
  {
    "title": "k6 latency p99",
    "expression": "1000 * k6_http_req_duration_p99{phase=\"load\"}",
    "status": "success",
    "series_count": 19
  },
  {
    "title": "k6 error rate",
    "expression": "k6_http_req_failed_rate{phase=\"load\"}",
    "status": "success",
    "series_count": 19
  },
  {
    "title": "Auth pods (cAdvisor)",
    "expression": "count(count by(pod) (container_memory_working_set_bytes{namespace=\"job-platform\",container=\"app\",pod=~\"auth-user-service-.*\"}))",
    "status": "success",
    "series_count": 1
  },
  {
    "title": "VM I/O wait %",
    "expression": "100 * avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[2m]))",
    "status": "success",
    "series_count": 1
  },
  {
    "title": "Kubernetes container logs",
    "expression": "{job=\"kubernetes\", namespace=\"job-platform\"}",
    "status": "success",
    "series_count": 2
  }
]