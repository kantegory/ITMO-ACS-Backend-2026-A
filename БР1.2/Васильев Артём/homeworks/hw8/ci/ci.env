# Ephemeral test environment only. No SSH or paid/larger runner.
ROOT="${GITHUB_WORKSPACE:?GitHub Actions workspace is required}"
BASE="$ROOT/БР1.2/Васильев Артём"
CLOUD="$BASE/labs/lab7/cloud"
LAB8="$BASE/labs/lab8"
source "$CLOUD/config.env"
CLUSTER_NAME=job-platform-lab
REGISTRY_NAME=job-platform-registry
K3D_VERSION=v5.9.0
K3D_SHA256=06d8f25bc3a971c4eb29e0ff08429b180402db0f4dec838c9eac427e296800a0
K3S_IMAGE=rancher/k3s:v1.34.13-k3s1
K6_VERSION=v2.4.0
K6_SHA256=5a5ecf23529ccf93135bc7e5b0c1cd5126ecf5f2672e22eed1556a0ab74abb87
export KUBECONFIG="${RUNNER_TEMP:?}/cloud-kubeconfig.yml"
export DEPLOY_STATE_DIR="$RUNNER_TEMP/cloud-state"
RESULTS="$RUNNER_TEMP/cloud-results"
export MKDOCS_SITE_URL=http://127.0.0.1:30080/docs/
export BASE_URL=http://127.0.0.1:30080/api/v1
export K6_PROMETHEUS_RW_SERVER_URL=http://127.0.0.1:9090/api/v1/write
export K6_PROMETHEUS_RW_TREND_STATS='p(95),p(99),avg,max'
export K6_NO_USAGE_REPORT=true
BASELINE_DURATION=60s
STRESS_STAGE_DURATION=20s
SPIKE_STAGE_DURATION=10s
SOAK_DURATION=300s
HPA_DURATION=180s
BASELINE_RATE=5
HPA_RATE=2
LOAD_VUS=32
HPA_SCALE_TIMEOUT=240
