# Run only on the authorized educational VPS, from the copied student subtree.
BASE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
CLOUD="$BASE/labs/lab7/cloud"
LAB8="$BASE/labs/lab8"
source "$CLOUD/config.env"
RESULTS=/opt/job-platform-cloud/acceptance/final
export RUNNER_TEMP="$RESULTS/tmp"
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
export PATH="$BASE/bin:$PATH"
export BASE_URL=http://127.0.0.1:30080/api/v1
export K6_PROMETHEUS_RW_SERVER_URL=http://127.0.0.1:9090/api/v1/write
export K6_PROMETHEUS_RW_TREND_STATS='p(95),p(99),avg,max'
export K6_NO_USAGE_REPORT=true
BASELINE_DURATION=60s
STRESS_STAGE_DURATION=30s
SPIKE_STAGE_DURATION=10s
SOAK_DURATION=20m
HPA_DURATION=180s
BASELINE_RATE=5
HPA_RATE=2
LOAD_VUS=32
HPA_SCALE_TIMEOUT=240
