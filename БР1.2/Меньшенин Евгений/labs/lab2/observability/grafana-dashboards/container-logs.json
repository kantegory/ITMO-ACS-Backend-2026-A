{
  "uid": "restaurant-container-logs",
  "title": "Restaurant — Container logs",
  "description": "Docker container logs collected by Alloy and stored in Loki.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "restaurant",
    "containers",
    "logs",
    "loki"
  ],
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "restaurant-loki"
        },
        "definition": "label_values({job=\"docker\"}, container)",
        "query": {
          "type": 1,
          "label": "container",
          "stream": "{job=\"docker\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Container logs",
      "description": "Select one or more containers above. All containers are shown by default.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "restaurant-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\", container=~\"${container:regex}\"}",
          "queryType": "range",
          "editorMode": "code",
          "direction": "backward"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "links": []
}
