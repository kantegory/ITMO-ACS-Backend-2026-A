{
  "name": "fitflow-backend-coursework",
  "version": "1.0.0",
  "private": true,
  "description": "ITMO ACS Backend 2026 coursework: fitness platform from monolith to microservices",
  "workspaces": ["apps/*", "services/*", "packages/*"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "dev:monolith": "tsc -b packages/shared apps/monolith && node --watch apps/monolith/dist/index.js",
    "dev:auth": "tsc -b packages/shared services/auth && node --watch services/auth/dist/index.js",
    "dev:workout": "tsc -b packages/shared services/workout && node --watch services/workout/dist/index.js",
    "dev:progress": "tsc -b packages/shared services/progress && node --watch services/progress/dist/index.js",
    "dev:content": "tsc -b packages/shared services/content && node --watch services/content/dist/index.js"
  },
  "dependencies": {
    "amqplib": "^0.10.7",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.26",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
