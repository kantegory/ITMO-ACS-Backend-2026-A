{
  "title": "Rental platform monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "Services available",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(probe_success{job=\"healthchecks\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU usage",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 4
      },
      "targets": [
        {
          "expr": "100 - avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100",
          "legendFormat": "CPU usage"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "RAM usage",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 4
      },
      "targets": [
        {
          "expr": "(1-node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes)*100",
          "legendFormat": "RAM used"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "Disk usage",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "expr": "(1-node_filesystem_avail_bytes{mountpoint=\"/\"}/node_filesystem_size_bytes{mountpoint=\"/\"})*100",
          "legendFormat": "Disk used"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "Network traffic",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[5m])",
          "legendFormat": "Network received"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])",
          "legendFormat": "Network sent"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "decimals": 1}}
    },
    {
      "type": "table",
      "title": "Healthcheck by service",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "probe_success{job=\"healthchecks\"}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "type": "logs",
      "title": "All container logs",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    }
  ]
}
