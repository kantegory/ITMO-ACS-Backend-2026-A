# Public read-only test routes for the shared VM.
ab.pxdkxvan.lol {
    @catalog {
        method GET
        path /api/v1/industries /api/v1/experience-levels
    }
    handle @catalog {
        reverse_proxy 127.0.0.1:18080
    }
    handle / {
        respond "ITMO Backend API. See /api/v1/industries or /api/v1/experience-levels." 200
    }
    handle {
        respond 404
    }
}
