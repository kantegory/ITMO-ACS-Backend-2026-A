ab.pxdkxvan.lol {
    @auth {
        method POST
        path /api/v1/auth/register /api/v1/auth/login /api/v1/auth/refresh
    }
    handle @auth {
        request_body {
            max_size 16KB
        }
        reverse_proxy 127.0.0.1:18083
    }
    @docs {
        method GET
        path /swagger-ui.html /swagger-ui/* /v3/api-docs /v3/api-docs/*
    }
    handle @docs {
        reverse_proxy 127.0.0.1:18083
    }
    handle / {
        redir * /swagger-ui.html 302
    }
    handle {
        respond 404
    }
}
